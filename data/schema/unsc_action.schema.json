{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Security Council action",
  "type": "object",
  "required": [
    "date",
    "subject",
    "russia_vote",
    "china_vote",
    "alignment",
    "alignment_basis",
    "verification"
  ],
  "properties": {
    "date": {
      "type": "string"
    },
    "symbol_or_topic": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "russia_vote": {
      "enum": [
        "yes",
        "no",
        "abstain",
        "veto",
        "absent"
      ]
    },
    "china_vote": {
      "enum": [
        "yes",
        "no",
        "abstain",
        "veto",
        "absent"
      ]
    },
    "outcome": {
      "enum": [
        "adopted",
        "blocked",
        "withdrawn",
        "not_tabled"
      ]
    },
    "alignment": {
      "enum": [
        "joint",
        "partial",
        "divergent"
      ],
      "description": "joint = both vetoed, or both took the same position. partial = one vetoed while the other abstained -- the abstainer withholds the second veto AND withholds support, which is cover rather than defection, so it must not be coded as divergence. divergent = one vetoed while the other voted in favour, the only shape that is a genuine public break."
    },
    "notes": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "verification": {
      "enum": [
        "verified",
        "pending_primary",
        "low_confidence_date",
        "disputed"
      ]
    },
    "alignment_basis": {
      "enum": [
        "both_veto",
        "one_veto_one_abstain",
        "one_veto_one_supports",
        "see_notes"
      ],
      "description": "The vote pattern the alignment code was derived from; makes the coding auditable."
    }
  }
}
